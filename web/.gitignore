# Build output
/.next/
/out/
/node_modules/
tsconfig.tsbuildinfo

# Generated by scripts/prepare-assets.mjs on every build: vendored runtime files
# copied out of node_modules, and the first paint summary built from the parquet.
# None of it is source, and the wasm alone is 77 MB.
/public/duckdb/
/public/maplibre/
/public/bootstrap.json

# Playwright. The panel screenshots are kept: they are what the smoke test
# produced on the last run, and a picture of the thing is cheaper to check than
# rebuilding it.
/test-results/
/playwright-report/
